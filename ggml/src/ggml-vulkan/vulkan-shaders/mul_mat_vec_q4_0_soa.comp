#version 450

// Phase-2 G: SoA q4_0, subgroupAdd, uint32 quant loads, rpw=8, local_size_x=64.
// Each thread now handles one block (nbk=64 blocks split across 64 threads),
// exposing more parallelism but losing the per-thread loop over 2 blocks.

#extension GL_EXT_shader_explicit_arithmetic_types_int8    : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16   : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32   : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage                     : require
#extension GL_EXT_shader_8bit_storage                      : require
#extension GL_EXT_control_flow_attributes                  : enable
#extension GL_KHR_shader_subgroup_arithmetic               : require
#extension GL_KHR_shader_subgroup_basic                    : require

#define ROWS_PER_WG 8u

// Override the spec constant to 64 threads.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer WQ { uint32_t   wq32[]; };
layout(set = 0, binding = 1) readonly buffer Xs { float        x[]; };
layout(set = 0, binding = 2) writeonly buffer Ys { float        y[]; };
layout(set = 0, binding = 3) readonly buffer WS { float16_t   ws[]; };

layout(push_constant) uniform Params {
    uint M;
    uint K;
} p;

// Up to 8 subgroups max.
shared float sg_partial[ROWS_PER_WG][8];

void main() {
    const uint tid      = gl_LocalInvocationID.x;
    const uint row0     = gl_WorkGroupID.x * ROWS_PER_WG;
    const uint nbk      = p.K / 32u;

    float acc[ROWS_PER_WG];
    [[unroll]] for (uint r = 0u; r < ROWS_PER_WG; ++r) acc[r] = 0.0;

    for (uint b = tid; b < nbk; b += 64u) {
        float xr0[16];
        float xr1[16];
        [[unroll]] for (uint j = 0u; j < 16u; ++j) {
            xr0[j] = x[b * 32u + j];
            xr1[j] = x[b * 32u + 16u + j];
        }

        [[unroll]] for (uint r = 0u; r < ROWS_PER_WG; ++r) {
            uint row       = row0 + r;
            uint q_base32  = row * (p.K / 8u);
            uint s_base    = row * nbk;
            uint qb32      = q_base32 + b * 4u;
            float d        = float(ws[s_base + b]);

            float sum = 0.0;
            [[unroll]] for (uint w = 0u; w < 4u; ++w) {
                uint packed = wq32[qb32 + w];
                [[unroll]] for (uint k = 0u; k < 4u; ++k) {
                    uint byte = (packed >> (k * 8u)) & 0xFFu;
                    float w0  = float(int(byte & 0xFu) - 8);
                    float w1  = float(int((byte >> 4) & 0xFu) - 8);
                    uint j    = 4u * w + k;
                    sum = fma(w0, xr0[j], sum);
                    sum = fma(w1, xr1[j], sum);
                }
            }
            acc[r] = fma(d, sum, acc[r]);
        }
    }

    [[unroll]] for (uint r = 0u; r < ROWS_PER_WG; ++r) {
        float sg_sum = subgroupAdd(acc[r]);
        if (subgroupElect()) sg_partial[r][gl_SubgroupID] = sg_sum;
    }
    barrier();

    if (tid < ROWS_PER_WG) {
        float total = 0.0;
        for (uint s = 0u; s < gl_NumSubgroups; ++s) total += sg_partial[tid][s];
        y[row0 + tid] = total;
    }
}
